{
  "name": "natours",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev | pino-pretty",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint --allow-empty-input \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:client": "node scripts/check-client-boundaries.ts",
    "check:conventions": "node scripts/check-conventions.ts",
    "check:env": "node scripts/check-env.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "mongoose": "9.12.0",
    "next": "16.4.5",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-security": "4.2.1",
    "knip": "6.44.2",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.34"
    }
  }
}
