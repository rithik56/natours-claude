# Copy to .env.local for local development. Never put a real secret in this file.

# Which environment the app runs in: development, test, ci, staging or production.
# This is separate from NODE_ENV so test, Playwright and Lighthouse runs behave correctly.
# Required, with no default, so a deployment that forgets it refuses to start.
APP_ENV=development

# The public origin of the app: scheme, host and optional port, with no path.
# It must be https in staging and production.
APP_URL=http://localhost:3000

# MongoDB connection string. `docker compose up -d --wait mongo` serves this one locally.
MONGODB_URI=mongodb://127.0.0.1:27017/natours

# How long to wait for MongoDB before answering 503, in milliseconds (100 to 30000).
DB_SERVER_SELECTION_TIMEOUT_MS=5000

# Required. At least 32 characters. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Origins allowed to call the public API from a browser, comma-separated. Empty allows none.
CORS_ORIGINS=

# Log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Pins the clock to a fixed ISO date or date and time. Used in development, test and ci only.
APP_NOW=
